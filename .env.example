# Скопируйте в .env и при необходимости поправьте.
# .env в git не попадает — см. .gitignore.

# --- Приложение ---
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=local-dev-secret-key-change-me-at-least-32-chars

# --- Postgres ---
POSTGRES_USER=remora
POSTGRES_PASSWORD=remora
POSTGRES_DB=remora
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://remora:remora@localhost:5432/remora

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_PASSWORD_RESET=5

# --- Meilisearch ---
MEILI_PORT=7700
MEILI_MASTER_KEY=remora-dev-master-key
MEILI_URL=http://localhost:7700

# --- S3 (локально MinIO) ---
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=remora
S3_SECRET_KEY=remora-dev-secret
S3_BUCKET_MEDIA=remora-media
S3_BUCKET_AUDIO=remora-audio
# MEDIA_IMAGE_MAX_SIZE_BYTES=10485760
# MEDIA_IMAGE_MAX_PIXELS=25000000

# --- Синтез речи (Яндекс SpeechKit) ---
# Без ключа режим «Аудирование» отключается сам и сообщает об этом в интерфейсе.
# Получить ключ: Яндекс Облако → сервисный аккаунт с ролью ai.speechkit-tts.user.
TTS_PROVIDER=disabled
# TTS_PROVIDER=yandex
# YANDEX_SPEECHKIT_API_KEY=
# YANDEX_SPEECHKIT_FOLDER_ID=
# TTS_MAX_CHARS_PER_REQUEST=500

# --- Почта (локально MailHog, UI на http://localhost:8025) ---
SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_FROM=noreply@remora.local
# Для внешнего SMTP задайте логин, пароль и STARTTLS. Например, Timeweb использует порт 587.
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=change-me
# SMTP_START_TLS=true

# --- Аутентификация ---
# Cookie для refresh-токена
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Сроки жизни токенов (переопределяют дефолты из config.py)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
# EMAIL_VERIFICATION_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=30

# --- URL фронтендов для ссылок в письмах ---
WEB_URL=http://localhost:3000
APP_URL=http://localhost:5173

# --- Фронтенды ---
# Публичный сайт: адрес API для серверных запросов Next.js
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:5173
VITE_WEB_URL=http://localhost:3000
# SPA: пусто — запросы идут через прокси Vite на тот же origin
VITE_API_URL=
