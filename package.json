{
  "name": "remora",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @remora/web dev",
    "dev:app": "pnpm --filter @remora/app dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "gen:api": "node scripts/gen-api-client.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": "6.2.1",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "follow-redirects": "1.16.1",
      "ip-address": "10.7.4",
      "js-yaml": "4.3.2",
      "postcss": "8.5.23",
      "postcss-selector-parser": "7.1.6",
      "sharp": "0.35.5",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2",
      "undici": "8.12.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  }
}
